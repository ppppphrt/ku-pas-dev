{
  "$defs": {
    "ChatState": {
      "additionalProperties": false,
      "properties": {
        "faculty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Faculty"
        },
        "min_credits": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Credits"
        },
        "max_credits": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Credits"
        },
        "days": {
          "items": {
            "enum": [
              "Mon",
              "Tue",
              "Wed",
              "Thu",
              "Fri",
              "Sat",
              "Sun"
            ],
            "type": "string"
          },
          "title": "Days",
          "type": "array"
        },
        "start_time": {
          "anyOf": [
            {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        },
        "end_time": {
          "anyOf": [
            {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time"
        },
        "offered_only": {
          "default": false,
          "title": "Offered Only",
          "type": "boolean"
        },
        "interest": {
          "default": "",
          "maxLength": 200,
          "title": "Interest",
          "type": "string"
        },
        "curriculum": {
          "anyOf": [
            {
              "enum": [
                "64",
                "67"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curriculum"
        },
        "group": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "competency": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competency"
        },
        "program": {
          "anyOf": [
            {
              "enum": [
                "regular",
                "special"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Program"
        }
      },
      "title": "ChatState",
      "type": "object"
    },
    "TimetableRef": {
      "additionalProperties": false,
      "properties": {
        "subject_code": {
          "title": "Subject Code",
          "type": "string"
        },
        "section_id": {
          "title": "Section Id",
          "type": "string"
        }
      },
      "required": [
        "subject_code",
        "section_id"
      ],
      "title": "TimetableRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "message": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ChatState"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/TimetableRef"
      },
      "maxItems": 100,
      "title": "Items",
      "type": "array"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    }
  },
  "required": [
    "message",
    "dataset_version"
  ],
  "title": "ChatRequest",
  "type": "object"
}
