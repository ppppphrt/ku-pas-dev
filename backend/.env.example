SEMANTIC_ENABLED=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MIN_CREDITS=9
MAX_CREDITS=22
# Optional: a secret of at least 32 characters. Local mode generates one automatically.
# JWT_SECRET=
# Optional local LLM. Export this environment variable before launching;
# no model is downloaded automatically. Used for understanding AND grounded replies.
# CHAT_OLLAMA_MODEL=your-installed-model
# GE_DATA_PATH=/absolute/path/to/normalized-ge-export.json

# Optional hosted LLM (Typhoon or a compatible Chat Completions provider).
# Server only. Never put API keys in VITE_ variables or commit .env files.
# Export these variables before launch; .env is not loaded automatically.
# LLM_API_KEY=
# LLM_MODEL=your-provider-model-id
# LLM_BASE_URL=https://api.opentyphoon.ai/v1
# If both are configured, hosted LLM takes priority over Ollama.

# Local alternative: copy chat.local.example.toml to chat.local.toml.
# Fill in api_key/model there; the server reads this ignored file automatically.

# Durable consent-based feedback on Vercel (PostgreSQL, e.g. Neon).
# FEEDBACK_DATABASE_URL=postgresql://... (POSTGRES_URL / DATABASE_URL also accepted)
# FEEDBACK_SIGNING_SECRET=unique-random-secret-at-least-32-characters
# FEEDBACK_REVIEW_TOKEN=another-unique-random-secret-at-least-32-characters
# Server-only secrets. Never expose in VITE_ variables.

# KU-EDU pilot enrollment lookup (server only; never use VITE_ names).
# KUEDU_USERNAME=
# KUEDU_PASSWORD=
# JSON mapping SHA-256 access-code digests to student_code and expires_at (with timezone).
# Generate entries offline: python backend/issue_enrollment_access.py STUDENT_CODE --days 7
# KUEDU_STUDENT_ACCESS={}
